# Copy to .env and fill in. Never commit .env.

# LLM (runtime scripts may override with deepseek-v3.2)
CHAT_MODEL=deepseek-v3.2
REASONING_MODEL=deepseek-v3.2

# Provider keys — use your org's gateway or OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: Spanagent / other backends if not using OpenAI-compatible API
# SPANAGENT_API_KEY=

# Factor mining: disable RAG to avoid embedding model issues and save memory
# QA_DISABLE_COSTEER_RAG=true
